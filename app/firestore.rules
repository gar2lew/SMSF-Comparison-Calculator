rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function getUserOrg() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId;
    }

    function sameOrg(docOrgId) {
      return request.auth != null && docOrgId == getUserOrg();
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function fieldsImmutable(docFields) {
      return request.resource.data.organisationId == resource.data.organisationId
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.schemaVersion == resource.data.schemaVersion;
    }

    // ============================================================
    // users — self-only
    // ============================================================
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ============================================================
    // organisations — member read, admin write
    // ============================================================
    match /organisations/{orgId} {
      allow get: if request.auth != null && orgId == getUserOrg();
      allow list: if false;
      allow create: if false;
      allow update: if request.auth != null && orgId == getUserOrg() && isAdmin();
      allow delete: if false;

      match /settings/{docId} {
        allow get: if request.auth != null && orgId == getUserOrg();
        allow list: if false;
        allow create: if request.auth != null && orgId == getUserOrg() && isAdmin();
        allow update: if request.auth != null && orgId == getUserOrg() && isAdmin();
        allow delete: if false;
      }
    }

    // ============================================================
    // clients
    // ============================================================
    match /clients/{clientId} {
      allow get: if sameOrg(resource.data.organisationId);
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.organisationId == getUserOrg()
        && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if sameOrg(resource.data.organisationId) && fieldsImmutable(resource.data);
      allow delete: if sameOrg(resource.data.organisationId) && isAdmin();
    }

    // ============================================================
    // projections
    // ============================================================
    match /projections/{projectionId} {
      allow get: if sameOrg(resource.data.organisationId);
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.organisationId == getUserOrg()
        && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if sameOrg(resource.data.organisationId) && fieldsImmutable(resource.data);
      allow delete: if sameOrg(resource.data.organisationId)
        && request.auth.uid == resource.data.ownerUserId;
    }

    // ============================================================
    // scenarios
    // ============================================================
    match /scenarios/{scenarioId} {
      allow get: if sameOrg(resource.data.organisationId);
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.organisationId == getUserOrg()
        && get(/databases/$(database)/documents/projections/$(request.resource.data.projectionId))
             .data.organisationId == getUserOrg();
      allow update: if sameOrg(resource.data.organisationId);
      allow delete: if sameOrg(resource.data.organisationId);
    }

    // ============================================================
    // notes
    // ============================================================
    match /notes/{noteId} {
      allow get: if sameOrg(resource.data.organisationId);
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.organisationId == getUserOrg()
        && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if sameOrg(resource.data.organisationId)
        && request.auth.uid == resource.data.ownerUserId;
      allow delete: if sameOrg(resource.data.organisationId)
        && request.auth.uid == resource.data.ownerUserId;
    }

    // ============================================================
    // activityLog — immutable audit trail
    // ============================================================
    match /activityLog/{logId} {
      allow get: if sameOrg(resource.data.organisationId);
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.organisationId == getUserOrg();
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // reports
    // ============================================================
    match /reports/{reportId} {
      allow get: if sameOrg(resource.data.organisationId);
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.organisationId == getUserOrg();
      allow update: if sameOrg(resource.data.organisationId)
        && request.auth.uid == resource.data.ownerUserId;
      allow delete: if sameOrg(resource.data.organisationId) && isAdmin();
    }
  }
}
